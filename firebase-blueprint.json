{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information for device synchronization across PC and mobile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID from Firebase Auth",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile last updated timestamp"
        }
      },
      "required": ["id", "createdAt", "updatedAt"]
    },
    "UserLanguageStats": {
      "title": "UserLanguageStats",
      "description": "Progress and statistics for ABC gastro training in Czech or English",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth User ID",
          "maxLength": 128
        },
        "language": {
          "type": "string",
          "description": "Language code: cs or en",
          "enum": ["cs", "en"]
        },
        "totalAnswered": {
          "type": "number",
          "description": "Total number of answered quiz questions"
        },
        "correctCount": {
          "type": "number",
          "description": "Total number of correct answers"
        },
        "currentStreak": {
          "type": "number",
          "description": "Current consecutive streak of correct answers"
        },
        "bestStreak": {
          "type": "number",
          "description": "Best consecutive streak achieved"
        },
        "masteredItemIds": {
          "type": "array",
          "description": "IDs of menu items that have all questions answered correctly"
        },
        "masteredQuestionIds": {
          "type": "array",
          "description": "IDs of questions answered correctly"
        },
        "mistakeQuestionIds": {
          "type": "array",
          "description": "IDs of questions currently marked as mistakes"
        },
        "lastDevice": {
          "type": "string",
          "description": "Device category that last updated the record (mobile or pc)",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the latest progress save"
        }
      },
      "required": [
        "userId",
        "language",
        "totalAnswered",
        "correctCount",
        "currentStreak",
        "bestStreak",
        "masteredItemIds",
        "masteredQuestionIds",
        "mistakeQuestionIds",
        "updatedAt"
      ]
    },
    "RestaurantAccount": {
      "title": "RestaurantAccount",
      "description": "Staff and administrator accounts synchronized across PC and mobile devices",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user account ID",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Unique login username",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Full display name of employee or admin",
          "maxLength": 128
        },
        "password": {
          "type": "string",
          "description": "Access password or PIN",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "System role: admin or staff",
          "enum": ["admin", "staff"]
        },
        "isSuperAdmin": {
          "type": "boolean",
          "description": "Owner super administrator flag"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the account is active"
        },
        "notes": {
          "type": "string",
          "description": "Internal notes or position details",
          "maxLength": 512
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last successful login timestamp"
        }
      },
      "required": ["id", "username", "name", "password", "role", "isActive"]
    }
  },
  "firestore": {
    "/restaurant_accounts/{accountId}": {
      "schema": "RestaurantAccount",
      "description": "Restaurant staff accounts database synced between PC and mobile devices"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles for authenticated sync"
    },
    "/users/{userId}/stats/{language}": {
      "schema": "UserLanguageStats",
      "description": "Per-language ABC training statistics synchronized across mobile devices and PC"
    },
    "/users/{userId}/test_stats/{language}": {
      "schema": "UserLanguageStats",
      "description": "Isolated test statistics for testing environment"
    }
  }
}
